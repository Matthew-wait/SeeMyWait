# Copy to apps/mobile/.env. EXPO_PUBLIC_* are inlined at build time; set the
# same values as EAS secrets for cloud builds.

EXPO_PUBLIC_SUPABASE_PROJECT_ID=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Android base map only — Google Maps SDK for Android is free / unlimited.
# iOS uses Apple Maps (PROVIDER_DEFAULT), no key. Geocoding + Places go through
# the medical-search edge function (NPPES / Census / Nominatim), so no geocode key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: ISO country for the browser-side Nominatim geocode fallback (default us)
EXPO_PUBLIC_GEOCODE_COUNTRY=us
