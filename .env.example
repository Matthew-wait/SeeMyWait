# Copy to `.env` or `.env.local` and fill in values from Supabase:
# Dashboard → Project Settings → API

# Project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Anon / publishable key (safe for the browser; still protect from abuse)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: ISO 3166-1 alpha-2 for Nominatim fallbacks in the browser (default us)
# Should match GOOGLE_GEOCODE_COUNTRY on the edge function when possible.
VITE_GEOCODE_COUNTRY=us

# -----------------------------------------------------------------------------
# Edge function `google-places` — set in Supabase Dashboard (Edge Functions → Secrets)
# or: supabase secrets set --env-file .env
#
# GOOGLE_MAPS_API_KEY     — Places, Distance Matrix, autocomplete, details, import
# GOOGLE_GEOCODE_API_KEY  — optional; Geocoding API only. If unset, geocode uses GOOGLE_MAPS_API_KEY
# GOOGLE_GEOCODE_COUNTRY  — optional; default us (bias for Geocoding + OSM fallback in the function)
#
# Hosted functions usually inject SUPABASE_URL and SUPABASE_ANON_KEY automatically.
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODE_API_KEY=
GOOGLE_GEOCODE_COUNTRY=us
