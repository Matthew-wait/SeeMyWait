# Copy to `.env` or `.env.local` and fill in values from Supabase:
# Dashboard → Project Settings → API

# Project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Anon / publishable key (safe for the browser; still protect from abuse)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: ISO 3166-1 alpha-2 for the browser-side Nominatim geocode fallback
# (default us).
VITE_GEOCODE_COUNTRY=us

# -----------------------------------------------------------------------------
# Map tiles (Leaflet) — replaces the old Google Maps JS widget.
#
# Raster XYZ tile template. Default = OpenStreetMap standard tiles: keyless and
# fine for development / low volume, but discouraged for heavy production use.
# For production pick a commercial-friendly free tier:
#   Stadia Maps  https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png
#                (free <=200k req/mo, domain-allowlisted key in VITE_MAP_TILE_KEY)
#   or self-host Protomaps (PMTiles) for a true $0 ceiling.
VITE_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
# Optional provider key; the app appends it as ?api_key=<key> when set.
VITE_MAP_TILE_KEY=

# -----------------------------------------------------------------------------
# Edge function `medical-search` (NPPES directory + geocoding). No API keys —
# all upstreams (NPPES NPI Registry, US Census geocoder, Nominatim, Photon) are
# free and keyless. Hosted Supabase injects SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY automatically. Optional overrides:
#   NPPES_API_BASE, NOMINATIM_BASE, PHOTON_BASE, GEOCODE_USER_AGENT
# -----------------------------------------------------------------------------
