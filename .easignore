# Keep EAS Build uploads lean — only apps/mobile + shared packages/supabase
# are needed to build the native app. https://docs.expo.dev/build-reference/easignore/
apps/web/
docs/
backups/
dist/
build/
scripts/out/
node_modules/
apps/*/node_modules/
packages/*/node_modules/
*.log
supabase/.temp/
# NPI_Data is gitignored (14GB+ of staged NPPES CSVs/checkpoints) but EAS's
# archive step doesn't reliably honor .gitignore for it — list explicitly.
# This alone was blowing the archive past EAS's 2.0GB upload limit.
NPI_Data/

# Firebase config files are gitignored (not committed) but ARE needed in the
# build archive for the native Firebase plugin prebuild step — without these,
# iOS prebuild fails with "Path to GoogleService-Info.plist is not defined."
!apps/mobile/google-services.json
!apps/mobile/GoogleService-Info.plist
